<mxfile host="drawio" version="26.0.0"><diagram name="SwiGLU 的分块计算与片上工作集"><mxGraphModel page="1" pageWidth="1200" pageHeight="700" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="SwiGLU 的分块计算与片上工作集" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=28;fontColor=#17212b;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.3;spacing=10;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="24" y="14" width="1152" height="48" as="geometry" /></mxCell><mxCell id="3" value="每次处理 m 个 token 与 n 个中间通道；遍历完当前 token 块的所有中间通道，再推进下一块。" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;fontColor=#17212b;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.3;spacing=10;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="24" y="75" width="1152" height="60" as="geometry" /></mxCell><mxCell id="4" value="输入块&lt;br&gt;m × d" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;fontColor=#17212b;fillColor=#dae8fc;strokeColor=#64748b;strokeWidth=1.3;spacing=10;" vertex="1" parent="1"><mxGeometry x="24" y="165" width="148" height="100" as="geometry" /></mxCell><mxCell id="5" value="gate 与 up 投影&lt;br&gt;两个 m × n 结果" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;fontColor=#17212b;fillColor=#dae8fc;strokeColor=#64748b;strokeWidth=1.3;spacing=10;" vertex="1" parent="1"><mxGeometry x="212" y="165" width="236" height="100" as="geometry" /></mxCell><mxCell id="6" value="SiLU 与逐元素乘&lt;br&gt;复用中间缓冲" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;fontColor=#17212b;fillColor=#d5e8d4;strokeColor=#64748b;strokeWidth=1.3;spacing=10;" vertex="1" parent="1"><mxGeometry x="488" y="165" width="236" height="100" as="geometry" /></mxCell><mxCell id="7" value="down 投影&lt;br&gt;逐通道块累加" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;fontColor=#17212b;fillColor=#dae8fc;strokeColor=#64748b;strokeWidth=1.3;spacing=10;" vertex="1" parent="1"><mxGeometry x="764" y="165" width="216" height="100" as="geometry" /></mxCell><mxCell id="8" value="输出&lt;br&gt;m × d" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;fontColor=#17212b;fillColor=#dae8fc;strokeColor=#64748b;strokeWidth=1.3;spacing=10;" vertex="1" parent="1"><mxGeometry x="1020" y="165" width="156" height="100" as="geometry" /></mxCell><mxCell id="9" source="4" target="5" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="10" source="5" target="6" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="11" source="6" target="7" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="12" source="7" target="8" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#64748b;strokeWidth=2;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="13" value="SRAM 中需要同时保留的数据" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=23;fontColor=#17212b;fillColor=#f5f5f5;strokeColor=#64748b;strokeWidth=1.3;spacing=10;container=1;pointerEvents=0;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="24" y="318" width="1152" height="230" as="geometry" /></mxCell><mxCell id="14" value="三组权重块&lt;br&gt;3 × d × n × b" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=22;fontColor=#17212b;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.3;spacing=10;" vertex="1" parent="13"><mxGeometry x="20" y="80" width="270" height="110" as="geometry" /></mxCell><mxCell id="15" value="输入块&lt;br&gt;m × d × b" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=22;fontColor=#17212b;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.3;spacing=10;" vertex="1" parent="13"><mxGeometry x="310" y="80" width="220" height="110" as="geometry" /></mxCell><mxCell id="16" value="gate 与 up 缓冲&lt;br&gt;2 × m × n × b" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=22;fontColor=#17212b;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.3;spacing=10;" vertex="1" parent="13"><mxGeometry x="550" y="80" width="270" height="110" as="geometry" /></mxCell><mxCell id="17" value="FP32 输出累加器&lt;br&gt;4 × m × d" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=22;fontColor=#17212b;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.3;spacing=10;" vertex="1" parent="13"><mxGeometry x="840" y="80" width="292" height="110" as="geometry" /></mxCell><mxCell id="18" value="蓝色为矩阵数据与计算，绿色为逐元素融合步骤；灰色区域列出分块工作集。" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=20;fontColor=#17212b;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.3;spacing=10;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="24" y="570" width="1152" height="40" as="geometry" /></mxCell><mxCell id="19" value="b 为输入和权重每元素字节数。完整 FFN 权重能放下时改为本次调用内保留；未计双缓冲与 bank 开销。" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=20;fontColor=#17212b;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.3;spacing=10;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="24" y="615" width="1152" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>